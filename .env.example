# Oslo Stock web-app runtime settings
#
# Defaults keep the app local-only at http://127.0.0.1:8765.

# OSLO_APP_HOST=127.0.0.1
# OSLO_APP_PORT=8765

# Optional custom SQLite path. Relative paths resolve from the project root.
# OSLO_APP_DB_PATH=app/data/oslo_workspace.sqlite3

# Optional backup destination for scripts/backup_database.sh and
# scripts/restore_database.sh. Backups are ignored by git.
# OSLO_APP_BACKUP_DIR=backups/sqlite

# Optional mirror destination for backup files and checksums. Use a mounted
# encrypted cloud folder, removable disk, or other off-host path.
# OSLO_APP_BACKUP_MIRROR_DIR=

# Optional Basic Auth. Required automatically for non-local bind hosts unless
# OSLO_APP_ALLOW_UNAUTHENTICATED_REMOTE=1 is set intentionally.
# OSLO_APP_REQUIRE_AUTH=1
# OSLO_APP_AUTH_USERNAME=
# OSLO_APP_AUTH_PASSWORD=

# Only use for a trusted network or reverse proxy setup where access is handled
# somewhere else. Do not use for public internet sharing.
# OSLO_APP_ALLOW_UNAUTHENTICATED_REMOTE=0
