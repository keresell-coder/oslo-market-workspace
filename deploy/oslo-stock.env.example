# Oslo Stock web-app hosted runtime environment
#
# Install as /etc/oslo-stock/oslo-stock.env on the host. Keep the installed
# file readable only by the service user/root because it contains credentials.

OSLO_APP_HOST=127.0.0.1
OSLO_APP_PORT=8765
OSLO_APP_REQUIRE_AUTH=1
OSLO_APP_AUTH_USERNAME=change-this-user
OSLO_APP_AUTH_PASSWORD=change-this-long-password

# Store runtime SQLite data outside the git checkout on persistent disk.
OSLO_APP_DB_PATH=/var/lib/oslo-stock/oslo_workspace.sqlite3

# Local host backups plus an off-host/encrypted mounted mirror destination.
OSLO_APP_BACKUP_DIR=/var/backups/oslo-stock/sqlite
OSLO_APP_BACKUP_MIRROR_DIR=/mnt/oslo-stock-backups/sqlite

